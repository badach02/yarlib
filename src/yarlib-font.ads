      'L' => [16#0F#, 16#06#, 16#06#, 16#06#, 16#46#, 16#66#, 16#7F#, 16#00#],
      'M' => [16#63#, 16#77#, 16#7F#, 16#7F#, 16#6B#, 16#63#, 16#63#, 16#00#],
      'N' => [16#63#, 16#67#, 16#6F#, 16#7B#, 16#73#, 16#63#, 16#63#, 16#00#],
      'O' => [16#1C#, 16#36#, 16#63#, 16#63#, 16#63#, 16#36#, 16#1C#, 16#00#],
      'P' => [16#3F#, 16#66#, 16#66#, 16#3E#, 16#06#, 16#06#, 16#0F#, 16#00#],
