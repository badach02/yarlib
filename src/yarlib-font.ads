      'Y' => [16#33#, 16#33#, 16#33#, 16#1E#, 16#0C#, 16#0C#, 16#1E#, 16#00#],
      'Z' => [16#7F#, 16#63#, 16#31#, 16#18#, 16#4C#, 16#66#, 16#7F#, 16#00#],
      '[' => [16#1E#, 16#06#, 16#06#, 16#06#, 16#06#, 16#06#, 16#1E#, 16#00#],
      '\' => [16#03#, 16#06#, 16#0C#, 16#18#, 16#30#, 16#60#, 16#40#, 16#00#],
      ']' => [16#1E#, 16#18#, 16#18#, 16#18#, 16#18#, 16#18#, 16#1E#, 16#00#],
      '^' => [16#08#, 16#1C#, 16#36#, 16#63#, 16#00#, 16#00#, 16#00#, 16#00#],
      '_' => [16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#FF#],
      '`' => [16#0C#, 16#0C#, 16#18#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#],
      'a' => [16#00#, 16#00#, 16#1E#, 16#30#, 16#3E#, 16#33#, 16#6E#, 16#00#],
      'b' => [16#07#, 16#06#, 16#06#, 16#3E#, 16#66#, 16#66#, 16#3B#, 16#00#],
      'c' => [16#00#, 16#00#, 16#1E#, 16#33#, 16#03#, 16#33#, 16#1E#, 16#00#],
      'd' => [16#38#, 16#30#, 16#30#, 16#3E#, 16#33#, 16#33#, 16#6E#, 16#00#],
      'e' => [16#00#, 16#00#, 16#1E#, 16#33#, 16#3F#, 16#03#, 16#1E#, 16#00#],
      'f' => [16#1C#, 16#36#, 16#06#, 16#0F#, 16#06#, 16#06#, 16#0F#, 16#00#],
      'g' => [16#00#, 16#00#, 16#6E#, 16#33#, 16#33#, 16#3E#, 16#30#, 16#1F#],
      'h' => [16#07#, 16#06#, 16#36#, 16#6E#, 16#66#, 16#66#, 16#67#, 16#00#],
      'i' => [16#0C#, 16#00#, 16#0E#, 16#0C#, 16#0C#, 16#0C#, 16#1E#, 16#00#],
