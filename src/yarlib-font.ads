--  8x8 Bitmap font for printable ASCII. Each glyph is stored as 8 rows of
--  1 byte, one bit per pixel. Build_Atlas draws them all into one Bitmap,
--  and Source returns a given character's rectangle in that Bitmap
--
--  Font Data: font8x8 by Daniel Hepper, from the IBM VGA fonts by way of
--  Marcel Sondaar. License: Public Domain.

with Bedrock; use Bedrock;

package Yarlib.Font with
   SPARK_Mode
is
   Glyph_Width : constant := 8;
   Glyph_Height : constant := 8;

   --  Value 0-255 with bitwise operation. Size is 1 byte
   type Glyph_Row is mod 2 ** Glyph_Width with Size => Glyph_Width;

   type Glyph_Rows is array (0 .. Glyph_Height - 1) of Glyph_Row;

   --  Printable ASCII font, one entry per character
   --  Each glyph is 8 rows top to bottom, with the lowest bit being the leftmost pixel
   --  Ex: 16#0C# -> 0 0 0 0 1 1 0 0 -> . . # # . . . .
   Bits : constant array (Character range ' ' .. '~') of Glyph_Rows :=
     [' ' => [16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#],
      '!' => [16#18#, 16#3C#, 16#3C#, 16#18#, 16#18#, 16#00#, 16#18#, 16#00#],
      '"' => [16#36#, 16#36#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#],
      '#' => [16#36#, 16#36#, 16#7F#, 16#36#, 16#7F#, 16#36#, 16#36#, 16#00#],
      '$' => [16#0C#, 16#3E#, 16#03#, 16#1E#, 16#30#, 16#1F#, 16#0C#, 16#00#],
      '%' => [16#00#, 16#63#, 16#33#, 16#18#, 16#0C#, 16#66#, 16#63#, 16#00#],
      '&' => [16#1C#, 16#36#, 16#1C#, 16#6E#, 16#3B#, 16#33#, 16#6E#, 16#00#],
      ''' => [16#06#, 16#06#, 16#03#, 16#00#, 16#00#, 16#00#, 16#00#, 16#00#],
      '(' => [16#18#, 16#0C#, 16#06#, 16#06#, 16#06#, 16#0C#, 16#18#, 16#00#],
      ')' => [16#06#, 16#0C#, 16#18#, 16#18#, 16#18#, 16#0C#, 16#06#, 16#00#],
      '*' => [16#00#, 16#66#, 16#3C#, 16#FF#, 16#3C#, 16#66#, 16#00#, 16#00#],
      '+' => [16#00#, 16#0C#, 16#0C#, 16#3F#, 16#0C#, 16#0C#, 16#00#, 16#00#],
      ',' => [16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#0C#, 16#0C#, 16#06#],
      '-' => [16#00#, 16#00#, 16#00#, 16#3F#, 16#00#, 16#00#, 16#00#, 16#00#],
      '.' => [16#00#, 16#00#, 16#00#, 16#00#, 16#00#, 16#0C#, 16#0C#, 16#00#],
      '/' => [16#60#, 16#30#, 16#18#, 16#0C#, 16#06#, 16#03#, 16#01#, 16#00#],
      '0' => [16#3E#, 16#63#, 16#73#, 16#7B#, 16#6F#, 16#67#, 16#3E#, 16#00#],
