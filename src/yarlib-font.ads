      ';' => [16#00#, 16#0C#, 16#0C#, 16#00#, 16#00#, 16#0C#, 16#0C#, 16#06#],
      '<' => [16#18#, 16#0C#, 16#06#, 16#03#, 16#06#, 16#0C#, 16#18#, 16#00#],
